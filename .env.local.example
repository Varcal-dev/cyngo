# Copia este archivo a .env.local y rellena con tus valores reales.
# .env.local NUNCA se sube a git (ya está en .gitignore).

# Dominio de tu tienda Shopify (sin https://)
SHOPIFY_STORE_DOMAIN=begusb-vf.myshopify.com

# Storefront API access token (genera uno NUEVO, revoca el que compartiste en el chat)
SHOPIFY_STOREFRONT_TOKEN=tu_nuevo_token_aqui

# Versión de la API (actualiza cada trimestre según changelog de Shopify)
SHOPIFY_API_VERSION=2024-10
